# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local Claude Code tooling (preview config, etc.)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts



# i18n audit — cache.json and report.md are meant to be committed, so they are
# not ignored (the cache doubles as the spend ledger, and first appears when a
# run saves it). These two are not: a temp file from an interrupted write, and
# an intermediate artifact that gets hand-applied to phrasebook.ts.
scripts/i18n-audit/cache.json.tmp
scripts/i18n-audit/notes-pa.generated.json

# The caches themselves are committed; saveCache writes <name>.json.tmp first
# and renames, so only a temp file left by an interrupted write is ignored —
# one rule, for every script that uses it.
scripts/**/*.json.tmp

# The Firebase emulators' logs (npm run test:rules, npm run emulators).
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log

# axe-core, copied for checking pages under next dev (npm run a11y:prepare).
/public/__dev/
